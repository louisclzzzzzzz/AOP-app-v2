# Clé API Mistral (OCR + LLM). Obtenir sur https://console.mistral.ai/
MISTRAL_API_KEY=

# Clé(s) de SECOURS, facultatives. Elles ne servent pas à répartir la charge : tous les appels
# partent sur MISTRAL_API_KEY, et une clé de secours ne prend le relais que si celle du dessus ne
# fonctionne plus (quota épuisé, clé révoquée, rate limit). Dès que la clé principale redevient
# utilisable, elle reprend la main automatiquement.
# MISTRAL_API_KEY_2=
# MISTRAL_API_KEY_3=

# Écriture alternative, si vous préférez tout sur une ligne (l'ordre reste l'ordre de priorité).
# Si elle est renseignée, elle l'emporte sur MISTRAL_API_KEY / _2 / _3 ci-dessus.
# MISTRAL_API_KEYS=cle_principale,cle_de_secours

# Répertoire de travail (dossiers en cours, cache OCR, DB SQLite).
# Laissez cette ligne commentée : la valeur par défaut est <racine_du_dépôt>/workspace
# (chemin absolu, calculé depuis l'emplacement du code — jamais depuis le répertoire courant).
# Si vous la renseignez, utilisez impérativement un chemin ABSOLU : ./start.sh lance le
# serveur depuis backend/, donc un chemin relatif comme "./workspace" pointerait vers
# backend/workspace/ (non ignoré par git) au lieu de la racine du dépôt.
# AOP_WORKSPACE_DIR=/chemin/absolu/vers/workspace

# Base SQLite (état des dossiers, cache OCR, résultats).
# Laissez cette ligne commentée : dérivée automatiquement de AOP_WORKSPACE_DIR.
# AOP_DATABASE_URL=sqlite:////chemin/absolu/vers/workspace/aop.db

# Port du backend FastAPI
AOP_BACKEND_PORT=8000

# Port du frontend Vite (dev)
AOP_FRONTEND_PORT=5173

# Authentification par code d'accès (4 chiffres, un par personne — pas de compte
# email/mot de passe). Off par défaut : usage local (./start.sh, l'exécutable Windows) reste
# sans friction. À activer pour un déploiement public exposé à quiconque a le lien (ex. Railway).
# Une fois activé, MISTRAL_API_KEY ci-dessus n'est PLUS utilisée pour l'analyse des dossiers :
# chaque personne enregistre sa propre clé Mistral personnelle dans l'application (menu
# « Clé API »), avec un guide intégré pour l'obtenir — voir backend/app/pipeline_support.py
# `owner_api_key`. Chacun consomme ainsi son propre quota.
# AOP_REQUIRE_AUTH=true
# Un code par personne, séparés par des virgules : révoquer l'accès de quelqu'un = retirer
# son code de la liste et redéployer, sans toucher aux codes des autres.
# AOP_ACCESS_CODES=1111,2222,3333

# Signe les cookies de session — nécessaire uniquement si AOP_REQUIRE_AUTH=true. Fixez une
# valeur aléatoire STABLE en production (ex. `openssl rand -base64 32`) : sans elle, une
# valeur est générée à chaque démarrage et déconnecte tout le monde à chaque redéploiement.
# AOP_SECRET_KEY=

# Journalisation complète (entrée/sortie/usage/troncatures) de chaque appel API Mistral dans
# <dossier>/api_calls.jsonl — désactivée par défaut, sans impact en prod. À renseigner
# uniquement pour instrumenter un run e2e (reconstituer un coût réel, déboguer une troncature).
# AOP_API_CALL_LOG_DIR=/chemin/absolu/vers/un/dossier/de/logs

# --- Veille automatique BOAMP / JOUE (facultatif) ------------------------------------------
# Recherche les avis de marchés publics d'assurance construction (dommages-ouvrage, tous
# risques chantier) sur le BOAMP et le JOUE/TED. Les deux API sont publiques et gratuites :
# aucune clé à fournir. Critères de ciblage : backend/config/veille_criteres.yaml.
#
# Par défaut, la recherche se contente de LISTER les avis : le retrait du DCE se fait ensuite
# à la main, avis par avis (bouton « Récupérer le DCE »), même quand la plateforme le
# permettrait automatiquement — ce n'est pas un effet anodin d'une recherche, c'est une
# décision par dossier. La recherche à la demande (bouton « Rechercher maintenant ») est
# toujours disponible. La recherche QUOTIDIENNE, elle, est désactivée par défaut : rien ne
# doit sortir seul vers des API externes sans décision explicite.
# AOP_VEILLE_DAILY_SCAN=true
# AOP_VEILLE_SCAN_HOUR=6

# Enchaîne automatiquement le retrait du DCE dès qu'un nouvel avis est trouvé, sans clic —
# désactivé par défaut (cf. ci-dessus). Ne concerne que les plateformes prises en charge
# (famille Atexo/PLACE, liens directs) ; ailleurs l'avis attend un retrait manuel de toute
# façon. Aucun appel LLM n'est déclenché : le dossier créé reste en attente, l'analyse ne
# démarre que sur clic (« Lancer l'analyse »).
# AOP_VEILLE_AUTO_RETRIEVAL=true

# Identité déclarée à l'acheteur lors d'un retrait de DCE. Les plateformes l'exigent (même en
# mode « anonyme » sur PLACE) et le retrait identifié a un vrai intérêt : il inscrit le retrait
# au registre de la consultation, ce qui oblige l'acheteur à notifier toute modification du DCE.
# Sans ces trois champs, le retrait automatique est simplement désactivé — jamais contourné
# par une identité fabriquée.
# AOP_VEILLE_CONTACT_NOM=
# AOP_VEILLE_CONTACT_PRENOM=
# AOP_VEILLE_CONTACT_EMAIL=
# Facultatifs, transmis quand ils sont renseignés (certains acheteurs les exigent) :
# AOP_VEILLE_CONTACT_RAISON_SOCIALE=
# AOP_VEILLE_CONTACT_SIRET=
# AOP_VEILLE_CONTACT_TELEPHONE=
# AOP_VEILLE_CONTACT_ADRESSE=
# AOP_VEILLE_CONTACT_CODE_POSTAL=
# AOP_VEILLE_CONTACT_VILLE=
