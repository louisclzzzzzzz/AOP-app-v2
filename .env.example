# Clé API Mistral (OCR + LLM). Obtenir sur https://console.mistral.ai/
MISTRAL_API_KEY=

# Clé(s) de SECOURS, facultatives. Elles ne servent pas à répartir la charge : tous les appels
# partent sur MISTRAL_API_KEY, et une clé de secours ne prend le relais que si celle du dessus ne
# fonctionne plus (quota épuisé, clé révoquée, rate limit). Dès que la clé principale redevient
# utilisable, elle reprend la main automatiquement.
# MISTRAL_API_KEY_2=
# MISTRAL_API_KEY_3=

# Écriture alternative, si vous préférez tout sur une ligne (l'ordre reste l'ordre de priorité).
# Si elle est renseignée, elle l'emporte sur MISTRAL_API_KEY / _2 / _3 ci-dessus.
# MISTRAL_API_KEYS=cle_principale,cle_de_secours

# Répertoire de travail (dossiers en cours, cache OCR, DB SQLite).
# Laissez cette ligne commentée : la valeur par défaut est <racine_du_dépôt>/workspace
# (chemin absolu, calculé depuis l'emplacement du code — jamais depuis le répertoire courant).
# Si vous la renseignez, utilisez impérativement un chemin ABSOLU : ./start.sh lance le
# serveur depuis backend/, donc un chemin relatif comme "./workspace" pointerait vers
# backend/workspace/ (non ignoré par git) au lieu de la racine du dépôt.
# AOP_WORKSPACE_DIR=/chemin/absolu/vers/workspace

# Base SQLite (état des dossiers, cache OCR, résultats).
# Laissez cette ligne commentée : dérivée automatiquement de AOP_WORKSPACE_DIR.
# AOP_DATABASE_URL=sqlite:////chemin/absolu/vers/workspace/aop.db

# Port du backend FastAPI
AOP_BACKEND_PORT=8000

# Port du frontend Vite (dev)
AOP_FRONTEND_PORT=5173

# Authentification par compte (email + mot de passe). Off par défaut : usage local
# (./start.sh, l'exécutable Windows) reste mono-utilisateur sans compte à créer. À activer
# pour un déploiement public exposé à quiconque a le lien (ex. Railway) — créez les comptes
# avec `uv run python scripts/create_user.py email@exemple.fr` (backend/), pas d'auto-inscription.
# AOP_REQUIRE_AUTH=true

# Signe les cookies de session — nécessaire uniquement si AOP_REQUIRE_AUTH=true. Fixez une
# valeur aléatoire STABLE en production (ex. `openssl rand -base64 32`) : sans elle, une
# valeur est générée à chaque démarrage et déconnecte tout le monde à chaque redéploiement.
# AOP_SECRET_KEY=
